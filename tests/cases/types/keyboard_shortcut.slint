// Test keyboard shortcut enum and to-platform-string conversion

export component TestKeyboardShortcut inherits Window {
    in-out property<bool> test: true;
    
    // Test that StandardShortcut enum values exist
    out property<StandardShortcut> copy_shortcut: StandardShortcut.copy;
    out property<StandardShortcut> paste_shortcut: StandardShortcut.paste;
    out property<StandardShortcut> undo_shortcut: StandardShortcut.undo;
    
    // Test that to-platform-string conversion works
    out property<string> copy_str: StandardShortcut.copy.to-platform-string();
    out property<string> cut_str: StandardShortcut.cut.to-platform-string();
    out property<string> paste_str: StandardShortcut.paste.to-platform-string();
    out property<string> select_all_str: StandardShortcut.select-all.to-platform-string();
    out property<string> find_str: StandardShortcut.find.to-platform-string();
    out property<string> save_str: StandardShortcut.save.to-platform-string();
    out property<string> print_str: StandardShortcut.print.to-platform-string();
    out property<string> undo_str: StandardShortcut.undo.to-platform-string();
    out property<string> redo_str: StandardShortcut.redo.to-platform-string();
    out property<string> refresh_str: StandardShortcut.refresh.to-platform-string();
    
    // Verify that the strings are not empty
    out property<bool> check: copy_str != "" && cut_str != "" && paste_str != "" 
        && select_all_str != "" && find_str != "" && save_str != "" 
        && print_str != "" && undo_str != "" && redo_str != "" && refresh_str != "";
}

/*
```rust
// Rust-specific tests for platform-specific formatting
let instance = TestKeyboardShortcut::new().unwrap();

// Get the shortcut strings
let copy_str = instance.get_copy_str();
let undo_str = instance.get_undo_str();

// Verify strings are not empty
assert!(!copy_str.is_empty(), "Copy shortcut string should not be empty");
assert!(!undo_str.is_empty(), "Undo shortcut string should not be empty");

// Platform-specific checks
#[cfg(target_os = "macos")]
{
    // On macOS, shortcuts should use the Command symbol (⌘)
    assert!(copy_str.contains("⌘"), "macOS copy shortcut should contain ⌘: {}", copy_str);
    assert!(copy_str.contains("C"), "macOS copy shortcut should contain C: {}", copy_str);
}

#[cfg(target_os = "windows")]
{
    // On Windows, shortcuts should use "Ctrl+"
    assert!(copy_str.contains("Ctrl"), "Windows copy shortcut should contain Ctrl: {}", copy_str);
    assert!(copy_str.contains("C"), "Windows copy shortcut should contain C: {}", copy_str);
    
    // Windows uses Ctrl+Y for Redo
    let redo_str = instance.get_redo_str();
    assert!(redo_str.contains("Ctrl"), "Windows redo shortcut should contain Ctrl: {}", redo_str);
    assert!(redo_str.contains("Y"), "Windows redo shortcut should contain Y: {}", redo_str);
}

#[cfg(not(any(target_os = "macos", target_os = "windows")))]
{
    // On Linux and other platforms, shortcuts should use "Ctrl+"
    assert!(copy_str.contains("Ctrl"), "Linux copy shortcut should contain Ctrl: {}", copy_str);
    assert!(copy_str.contains("C"), "Linux copy shortcut should contain C: {}", copy_str);
    
    // Linux uses Ctrl+Shift+Z for Redo
    let redo_str = instance.get_redo_str();
    assert!(redo_str.contains("Ctrl"), "Linux redo shortcut should contain Ctrl: {}", redo_str);
    assert!(redo_str.contains("Shift"), "Linux redo shortcut should contain Shift: {}", redo_str);
    assert!(redo_str.contains("Z"), "Linux redo shortcut should contain Z: {}", redo_str);
}

// Verify that check property is true
assert!(instance.get_check(), "All shortcut strings should be non-empty");
```
*/
